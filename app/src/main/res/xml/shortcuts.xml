<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <capability android:name="actions.intent.PLAY_MEDIA">
        <intent
            android:action="android.media.action.MEDIA_PLAY_FROM_SEARCH"
            android:targetClass="io.github.sekademi.spotufi.MainActivity">
            <parameter
                android:name="media.name"
                android:key="query" />
        </intent>
        <intent
            android:action="android.intent.action.VIEW"
            android:data="atify://play?query={query}"
            android:targetClass="io.github.sekademi.spotufi.MainActivity">
            <parameter
                android:name="media.name"
                android:key="query" />
        </intent>
    </capability>

    <capability android:name="actions.intent.PLAY_MUSIC">
        <intent
            android:action="android.media.action.MEDIA_PLAY_FROM_SEARCH"
            android:targetClass="io.github.sekademi.spotufi.MainActivity">
            <parameter
                android:name="music.recording.name"
                android:key="query" />
            <parameter
                android:name="music.album.name"
                android:key="query" />
            <parameter
                android:name="music.musicGroup.name"
                android:key="query" />
            <parameter
                android:name="music.genre"
                android:key="query" />
            <parameter
                android:name="music.playlist.name"
                android:key="query" />
        </intent>
        <intent
            android:action="android.intent.action.VIEW"
            android:data="atify://play?query={query}"
            android:targetClass="io.github.sekademi.spotufi.MainActivity">
            <parameter
                android:name="music.recording.name"
                android:key="query" />
        </intent>
    </capability>

    <capability android:name="actions.intent.OPEN_APP_FEATURE">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="atify://play?query={feature}"
            android:targetClass="io.github.sekademi.spotufi.MainActivity">
            <parameter
                android:name="feature"
                android:key="feature" />
        </intent>
    </capability>

    <capability android:name="actions.intent.RESUME_MUSIC">
        <intent
            android:action="android.media.action.MEDIA_PLAY_FROM_SEARCH"
            android:targetClass="io.github.sekademi.spotufi.MainActivity" />
    </capability>

    <capability android:name="actions.intent.PAUSE_MUSIC">
        <intent
            android:action="android.media.action.MEDIA_PLAY_FROM_SEARCH"
            android:targetClass="io.github.sekademi.spotufi.MainActivity" />
    </capability>

    <shortcut
        android:shortcutId="play_music"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_play_music"
        android:shortcutLongLabel="@string/shortcut_play_music_desc">
        <intent
            android:action="android.media.action.MEDIA_PLAY_FROM_SEARCH"
            android:targetClass="io.github.sekademi.spotufi.MainActivity" />
        <capability-binding android:key="actions.intent.PLAY_MEDIA" />
    </shortcut>

    <shortcut
        android:shortcutId="liked_songs"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_liked_songs"
        android:shortcutLongLabel="@string/shortcut_liked_songs_desc">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="atify://play?query=liked"
            android:targetClass="io.github.sekademi.spotufi.MainActivity" />
        <capability-binding android:key="actions.intent.PLAY_MEDIA" />
    </shortcut>
</shortcuts>
